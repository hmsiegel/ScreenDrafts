#!/bin/sh
# Blocks a commit that adds a secret. Enable once per clone:
#   git config core.hooksPath .githooks
# Accepted historical findings live in .gitleaksignore.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found on PATH (winget install Gitleaks.Gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --verbose
