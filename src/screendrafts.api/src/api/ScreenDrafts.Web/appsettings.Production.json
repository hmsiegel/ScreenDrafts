{
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://auth.screen-drafts.com/realms/screendrafts"
      ]
    },
    "MetadataAddress": "https://auth.screen-drafts.com/realms/screendrafts/.well-known/openid-configuration",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.screen-drafts.com",
      "https://screen-drafts.com"
    ]
  },
  "KeyCloak": {
    "HealthUrl": "http://screendrafts.identity:8080/health/"
  },
  "Audit": {
    "KeycloakPoller": {
      "AdminUrl": "http://screendrafts.identity:8080/admin/realms/screendrafts/",
      "TokenUrl": "http://screendrafts.identity:8080/realms/screendrafts/protocol/openid-connect/token",
      "ConfidentialClientId": "screendrafts-confidential-client",
      "Realm": "screendrafts"
    }
  },
  "Users": {
    "KeyCloak": {
      "AdminUrl": "http://screendrafts.identity:8080/admin/realms/screendrafts/",
      "TokenUrl": "http://screendrafts.identity:8080/realms/screendrafts/protocol/openid-connect/token",
      "ConfidentialClientId": "screendrafts-confidential-client",
      "PublicClientId": "screendrafts-public-client"
    }
  },
  "Drafts": {
    "People": {
      "CommissionerPersonPublicIds": [
        "pe_FssS7cwtd2b78SC",
        "pe_qxaLv3nTNTjZqtF"
      ]
    }
  },
  "Integrations": {
    "Tmdb": {
      "BaseImageAddress": "https://image.tmdb.org/t/p/",
      "BaseAddress": "https://api.themoviedb.org/3/",
      "TrailerPlaceholder": "https://via.placeholder.com/500x750?text=No+Trailer"
    },
    "Igdb": {
      "BaseAddress": "https://api.igdb.com/v4/",
      "TwitchTokenUrl": "https://id.twitch.tv/oauth2/token"
    },
    "Zoom": {
      "BaseAddress": "https://api.zoom.us/v2/"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/screendrafts/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Screendrafts.Web"
    }
  },
  "OpenApi": {
    "Title": "ScreenDrafts API",
    "Version": "v1",
    "Description": "API for ScreenDrafts",
    "TermsOfServiceUri": "https://www.screen-drafts.com/terms",
    "Contact": {
      "Name": "Harlan Siegel",
      "Email": "hmsiegel@gmail.com",
      "Url": "https://www.github.com/hmsiegel/screendrafts"
    },
    "License": {
      "Name": "GNU General Public License v3",
      "Url": "https://opensource.org/licenses/gpl-3-0"
    }
  }
}
