# screen-drafts.com Caddyfile
# TLS is automatic via Let's Encrypt.
# Cloudflare sits in front (proxied/orange-cloud) — real client IPs arrive
# via CF-Connecting-IP and X-Forwarded-For. The `trusted_proxies static`
# block below tells Caddy which peer IPs are legitimate Cloudflare edge
# nodes; only requests whose immediate TCP peer is in this list have their
# forwarded-for header trusted at all. This is what makes the `client_ip`
# matcher (used below, instead of `remote_ip`) resolve to the real visitor
# IP rather than Cloudflare's own edge IP.
#
# Cloudflare's IP ranges change occasionally — check https://www.cloudflare.com/ips/
# periodically and update the list below if entries are added/removed.
#
# IF CLOUDFLARE PROXY IS EVER TURNED OFF (DNS-only/grey-cloud) for a
# domain: requests arrive directly from the visitor, and `client_ip` still
# works correctly (falls back to the actual TCP peer when no trusted
# forwarded-for chain is present) — no Caddyfile change needed either way.
# This config is written to be correct in both proxy states.

{
	email hmsiegel@gmail.com

	servers {
		trusted_proxies static \
			173.245.48.0/20 \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			141.101.64.0/18 \
			108.162.192.0/18 \
			190.93.240.0/20 \
			188.114.96.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			162.158.0.0/15 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			172.64.0.0/13 \
			131.0.72.0/22 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32
	}
}

# API
api.screen-drafts.com {
	reverse_proxy screendrafts.web:8080 {
		# Pass real client IP from Cloudflare
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	# SignalR WebSocket passthrough
	@signalr path /drafts/hub*
	reverse_proxy @signalr screendrafts.web:8080 {
		header_up Connection {http.request.header.Connection}
		header_up Upgrade {http.request.header.Upgrade}
	}
}

# Keycloak
auth.screen-drafts.com {
	# Keycloak management surfaces (admin console + REST, master realm login/account):
	# home IP only. Everything else (screendrafts realm login, Google broker, static
	# resources) stays public. The API reaches the admin REST API over the internal
	# Docker network (screendrafts.identity:8080), not through this block.
	#
	# Uses `client_ip`, not `remote_ip` — client_ip resolves the real visitor
	# IP via the trusted_proxies chain above, which is required once Cloudflare
	# is proxied (remote_ip would see Cloudflare's edge IP, never matching
	# ADMIN_IP, locking everyone out including you).
	#
	# ADMIN_IP comes from the caddy service's environment (.env), so the address
	# stays out of this public repo. If it is unset the default is a
	# documentation address nobody uses, which fails closed (management paths
	# stay blocked).
	@management {
		path /admin /admin/* /realms/master /realms/master/*
		not client_ip {$ADMIN_IP:192.0.2.1}
	}
	handle @management {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy screendrafts.identity:8080 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
