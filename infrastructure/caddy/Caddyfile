# screen-drafts.com Caddyfile
# TLS is automatic via Let's Encrypt.
# Cloudflare sits in front — real client IPs are forwarded via CF-Connecting-IP.

{
	email hmsiegel@gmail.com
}

# API
api.screen-drafts.com {
	reverse_proxy screendrafts.web:8080 {
		# Pass real client IP from Cloudflare
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	# SignalR WebSocket passthrough
	@signalr path /drafts/hub*
	reverse_proxy @signalr screendrafts.web:8080 {
		header_up Connection {http.request.header.Connection}
		header_up Upgrade {http.request.header.Upgrade}
	}
}

# Keycloak
auth.screen-drafts.com {
	# Keycloak management surfaces (admin console + REST, master realm login/account):
	# home IP only. Everything else (screendrafts realm login, Google broker, static
	# resources) stays public. The API reaches the admin REST API over the internal
	# Docker network (screendrafts.identity:8080), not through this block.
	# remote_ip is the real client IP only while auth.* is DNS-only (grey cloud) in
	# Cloudflare. If it is ever proxied, switch to client_ip + trusted_proxies.
	# ADMIN_IP comes from the caddy service's environment (.env), so the address stays
	# out of this public repo. If it is unset the default is a documentation address
	# nobody uses, which fails closed (management paths stay blocked).
	@management {
		path /admin /admin/* /realms/master /realms/master/*
		not remote_ip {$ADMIN_IP:192.0.2.1}
	}
	handle @management {
		respond "Forbidden" 403
	}

	handle {
		reverse_proxy screendrafts.identity:8080 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
