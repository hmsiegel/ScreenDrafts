# infrastructure/test/overrides.env
#
# Copy to /opt/screendrafts/overrides.env on the TEST server only.
# docker-compose.production.yml loads it into the API container if it exists
# (env_file, required: false). PROD has no such file, so PROD is unaffected.
#
# Holds no secrets: hostnames and the mail sink. Keys use "__" for ":".
# Values here beat the baked-in appsettings.Production.json.

# Keycloak issuer and metadata: the TEST Keycloak, not production's.
Authentication__TokenValidationParameters__ValidIssuers__0=https://auth-test.screen-drafts.com/realms/screendrafts
Authentication__MetadataAddress=https://auth-test.screen-drafts.com/realms/screendrafts/.well-known/openid-configuration

# CORS: only the TEST site may call the TEST API (two slots, same origin).
Cors__AllowedOrigins__0=https://test.screen-drafts.com
Cors__AllowedOrigins__1=https://test.screen-drafts.com

# Links and assets in emails point at the TEST site.
Communications__PublicAssetsBaseUrl=https://test.screen-drafts.com

# Mail: everything goes to Mailpit, nothing leaves the server.
# An empty Username makes SmtpEmailService skip authentication.
Communications__Smtp__Host=screendrafts.mailpit
Communications__Smtp__Port=1025
Communications__Smtp__SecureSocketOptions=None
Communications__Smtp__Username=
